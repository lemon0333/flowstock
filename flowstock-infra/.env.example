# FlowStock Secrets - Copy to .env and fill in values
DB_PASSWORD=
REDIS_PASSWORD=
JWT_SECRET=
# CLAUDE_API_KEY는 더 이상 필요하지 않습니다.
# AI 서비스는 Claude Code SDK를 사용하므로 서버에서 `claude login`을 실행하세요.
KIS_APP_KEY=
KIS_APP_SECRET=
DART_API_KEY=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
GOOGLE_CLIENT_ID=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
MYSQL_ROOT_PASSWORD=
MYSQL_PASSWORD=

# Umami Analytics (자체호스팅) — 32+ chars random
# 생성: openssl rand -hex 32
UMAMI_APP_SECRET=

# ── Terraform 변수 (TF_VAR_ prefix로 자동 주입) ──
# Grafana alert 수신 이메일 목록 — JSON 배열 그대로
# 예: TF_VAR_alert_recipient_emails=["andyhyunbin@gmail.com"]
TF_VAR_alert_recipient_emails=[]
