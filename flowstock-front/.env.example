# FlowStock Frontend - Vite 빌드타임 치환 환경변수
# 운영 빌드(GitHub Actions)에서는 secrets 로 주입, 로컬은 .env.local 만들어서 사용

# Backend API base URL (vite dev proxy 경유면 /api 그대로)
VITE_API_URL=/api

# Google OAuth Web Client ID (Google Cloud Console)
VITE_GOOGLE_CLIENT_ID=

# Naver OAuth Client ID + Callback
VITE_NAVER_CLIENT_ID=
VITE_NAVER_CALLBACK_URL=https://flowstock.info/login

# Umami Analytics (자체호스팅) — 둘 다 설정되어야 트래커 활성
# script URL: 자체호스팅한 Umami 의 도메인 + /script.js
VITE_UMAMI_SCRIPT_URL=https://analytics.flowstock.info/script.js
# 웹사이트 ID: Umami UI 에서 사이트 등록 후 발급되는 UUID
VITE_UMAMI_WEBSITE_ID=
