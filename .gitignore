# Local .terraform directories (바이너리 및 플러그인 포함)
**/.terraform/*

# .tfstate 파일 (민감 정보 포함 및 충돌 방지)
*.tfstate
*.tfstate.*

# .env 및 민감한 변수 파일
.env
*.tfvars
*.tfvars.json

# OS 관련 파일
.DS_Store

# Python venv (테스트용)
.venv/
.venv-test/
.venv-airflow/
__pycache__/
.pytest_cache/

# Airflow runtime (DB, logs, cfg — repo에 안 박음)
.airflow-home/

# CodeGraph 인덱스 / Cursor 룰 자동생성 — 머신 로컬
.codegraph/
.cursor/

# Airflow docker-compose 로컬 적재 데이터
flowstock-airflow/.localdata/

# Node
node_modules/
flowstock-front/dist/

# Gradle
flowstock-backend/.gradle/
flowstock-backend/build/
flowstock-backend/*/build/
